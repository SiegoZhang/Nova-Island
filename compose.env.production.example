# 生产上线：复制为仓库根目录 .env 后由 docker compose 读取
#   cp compose.env.production.example .env
#
# 下方所有 <...> 占位符都必须替换。APP_ENV=production 时后端会强制校验：
# 拒绝弱 / 默认 JWT 密钥、拒绝 DB_SEED=true、拒绝演示种子密码，
# 配置不合规时容器会直接启动失败，而不是降级运行。

APP_ENV=production

# ---------- 站点域名（供 Caddy 申请证书 + 反向代理）----------
# 多个域名用逗号分隔，例如：example.com, www.example.com
SITE_DOMAIN=<your.domain>

# ---------- 数据库 ----------
MYSQL_DATABASE=nova_island
MYSQL_PASSWORD=<强密码，勿用 123456 / password>

# ---------- 安全 ----------
# 生成：openssl rand -hex 32
JWT_SECRET=<64 位随机十六进制串>
# 生产必须 false：不写入演示账号
DB_SEED=false
SEED_DEFAULT_PASSWORD=<随机串，仅占位，不会被使用>

# ---------- 跨域与媒体地址 ----------
CORS_ORIGINS=["https://<your.domain>"]
STORAGE_PUBLIC_BASE_URL=https://<your.domain>/media
API_INTERNAL_BASE_URL=http://backend:8000/api/v1

# ---------- HTTPS ----------
ENABLE_HTTPS_SECURITY_HEADERS=true
REFRESH_COOKIE_SECURE=true
# 前后端同站可留空；拆子域时填写例如 .your.domain
REFRESH_COOKIE_DOMAIN=

# ---------- 可选：构建加速镜像源（中国大陆网络环境）----------
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# UV_HTTP_TIMEOUT=180

# ---------- 端口（公网只需放行 80 / 443）----------
FRONT_PORT=3000
BACKEND_PORT=8000
LOG_LEVEL=INFO
