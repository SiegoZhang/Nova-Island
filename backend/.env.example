# FastAPI
APP_NAME=Nova Island API
APP_VERSION=0.1.0
# development | production（production 会强制校验密钥强度并关闭 /docs）
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# MySQL（推荐 127.0.0.1，避免 localhost 走 unix socket）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nova_island_demo
MYSQL_USER=root
MYSQL_PASSWORD=123456

# 可选：直接覆盖完整 SQLAlchemy 异步连接串（一般无需设置）
# DATABASE_URL=

# 数据库行为开关
# MySQL 正式开发/生产：DB_AUTO_CREATE=false，用 Alembic 管理 schema
DB_AUTO_CREATE=false
DB_SEED=true
DB_ECHO=false

# JWT 认证（生产务必替换为足够长的随机密钥，>=32 字符）
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# 短期 access Cookie 仅用于服务端只读请求识别身份
ACCESS_COOKIE_NAME=nova.access
ACCESS_COOKIE_PATH=/
# refresh JWT 仅通过 HttpOnly Cookie 下发；生产默认 Secure=true
REFRESH_COOKIE_NAME=nova.refresh
REFRESH_COOKIE_PATH=/api/v1/auth
# REFRESH_COOKIE_DOMAIN=.example.com
# REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
# 种子演示用户的默认密码（生产禁止沿用 island@2026）
SEED_DEFAULT_PASSWORD=island@2026

# Redis（限流 / refresh 会话与黑名单 / 热数据缓存）
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_LIMIT=30
RATE_LIMIT_WINDOW_SECONDS=60
# 航海/专栏/榜单/活动列表短 TTL（秒）；0 关闭缓存
CACHE_TTL_SECONDS=60

# 榜单日更（Asia/Shanghai 默认每天 03:00）
RANKING_RECALC_ENABLED=true
RANKING_RECALC_HOUR=3
RANKING_RECALC_MINUTE=0
RANKING_RECALC_TIMEZONE=Asia/Shanghai
RANKING_TOP_N=50

# 对象存储（默认本地；切 S3/MinIO 时改 STORAGE_BACKEND=s3 并配置下方项）
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_ATTACHMENTS_PER_POST=10
# STORAGE_BACKEND=s3
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT_URL=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_PREFIX=
# STORAGE_S3_PUBLIC_BASE_URL=

# 日志：LOG_JSON 留空则 production 自动 JSON，development 人类可读
LOG_LEVEL=INFO
# LOG_JSON=true
