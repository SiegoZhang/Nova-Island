# 复制为仓库根目录 .env 后供 docker compose 读取：
#   cp compose.env.example .env
#
# ---------- 本地联调（默认）----------
APP_ENV=development
MYSQL_DATABASE=nova_island
MYSQL_PASSWORD=nova_island_dev
DB_SEED=true
SEED_DEFAULT_PASSWORD=island@2026
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
CORS_ORIGINS=["http://localhost:3000"]
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/media
API_INTERNAL_BASE_URL=http://backend:8000/api/v1
# 本地 HTTP 必须 false；上线 HTTPS 改为 true 并 rebuild front
ENABLE_HTTPS_SECURITY_HEADERS=false
FRONT_PORT=3000
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ---------- 生产示例（上线时替换上面段落）----------
# APP_ENV=production
# MYSQL_PASSWORD=<强密码，勿用 123456/password>
# DB_SEED=false
# SEED_DEFAULT_PASSWORD=<随机串>
# JWT_SECRET=<openssl rand -hex 32>
# CORS_ORIGINS=["https://your.domain"]
# STORAGE_PUBLIC_BASE_URL=https://your.domain/media
# ENABLE_HTTPS_SECURITY_HEADERS=true
# REFRESH_COOKIE_SECURE=true
# # 前后端同站可留空；子域拆分时例如 .your.domain
# REFRESH_COOKIE_DOMAIN=
